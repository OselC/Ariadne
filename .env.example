# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_PROJECT_ID=your-project-id

# ── OpenAI (GPT-4o Vision - Intelligence Engine) ──
OPENAI_API_KEY=sk-...

# ── Replicate (IDM-VTON / Flux + LoRA - Rendering Engine) ──
REPLICATE_API_TOKEN=r8_...

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MOCK_AI=false
# Set to true to use mock responses without hitting OpenAI/Replicate (for demo without keys)

# ── Optional: YOLOv8 inference endpoint (if self-hosted) ──
YOLO_API_URL=http://localhost:8000/predict
